userSections = tlsr, clsr, lvlset

[GENERAL]
startFrom = "ss1.fld"
polynomialOrder = 5
stopAt = endTime
endTime = 40
#stopAt = numSteps
#numSteps = 100

dt = initial=1e-06+targetCFL=0.2+max=2e-4

timeStepper = tombo2

#checkPointInterval = 50
checkpointControl = simulationTime
checkPointInterval = 0.1

scalars = tls, cls

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet, zeroDirichlet, outlet, zeroDirichlet, zeroDirichlet, inlet, zeroDirichlet
#regularization = svv+scalingCoeff=1.0+filterPower=2.0
residualTol = 1e-6

[FLUID PRESSURE]
residualTol = 1e-6

[SCALAR TLS]
boundaryTypeMap = zeroNeumann, zeroNeumann, zeroNeumann, zeroNeumann, zeroNeumann, zeroNeumann, zeroNeumann
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv


[SCALAR CLS]
boundaryTypeMap = inlet, zeroNeumann, inlet, zeroNeumann, zeroNeumann, inlet, zeroNeumann
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv

[TLSR]
solveFrequency = 2e-2
residualTol = 1e-8
maximumSteps = 750
regularization = svv+scalingCoeff=1.0+filterPower=7.0

[CLSR]
solveFrequency = 2e-3
residualTol = 1e-8
maximumSteps = 50

[LVLSET]
interfaceWidthFactor = 2.5
interfaceWidthMesh = mean
