void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    // Uref is the dimensional inlet speed, so the nondimensional inlet
    // velocity is unity in magnitude and points in the -z direction.
    bc->uzFluid = -1.0;
  } else if (isField("fluid pressure")) {
    const dfloat iU0delta = 1.0;
    const dfloat un = bc->uxFluid * bc->nx + bc->uyFluid * bc->ny + bc->uzFluid * bc->nz;
    const dfloat s0 = 0.5 * (1.0 - tanh(un * iU0delta));
    const dfloat rho = bc->transCoeff;
    bc->pFluid = -0.5 * rho * (bc->uxFluid * bc->uxFluid + bc->uyFluid * bc->uyFluid + bc->uzFluid * bc->uzFluid) * s0;
  } else if (isField("scalar cls") || isField("clsr")) {
    if(bc->id == 1) {
      bc->sScalar = 1.0;
    } else if(bc->id == 3 || bc->id == 6) {
      bc->sScalar = 0.0;
    }
  } else if (isField("scalar c")) {
    // The species enters with the gas at the tube inlets.
    if(bc->id == 6) {
      bc->sScalar = 1.0;
    }
  }
}

// Strong Continuum Species Transport (SCST):
//   dc/dt + u.grad(c) = div(D grad(c)) + div(K c grad(psi)),
//   D = (D1 H psi + D2 (1 - psi)) / (H psi + 1 - psi),
//   K = (1 - H) D / (H psi + 1 - psi),
// with psi the liquid fraction (CLS), D1 = 1/Pe and D2 = D1/diffRatio the
// liquid and gas diffusivities and H = solubilityRatio the dimensionless
// Henry constant (liquid c / gas c at equilibrium).
//
// The total flux
//   -D grad(c) - K c grad(psi)
// vanishes at Henry equilibrium across the interface.
dfloat scstDiffusivity(const dfloat psi,
                       const dfloat solubilityRatio,
                       const dfloat diffRatio,
                       const dfloat Pe)
{
  const dfloat p = fmin(1.0, fmax(0.0, psi));
  return (solubilityRatio * p + (1.0 - p) / diffRatio) / (Pe * (solubilityRatio * p + 1.0 - p));
}

@kernel void speciesDiffusivity(const dlong N,
                                const dfloat solubilityRatio,
                                const dfloat diffRatio,
                                const dfloat Pe,
                                @ restrict const dfloat *PSI,
                                @ restrict dfloat *DIFF)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    DIFF[n] = scstDiffusivity(PSI[n], solubilityRatio, diffRatio, Pe);
  }
}

// SCST pseudo-advective flux F = K c grad(psi), with grad(psi) taken as
// delta * grad(phi)/|grad(phi)|. F must hold grad(phi) as input.
@kernel void scstFlux(const dlong N,
                      const dlong offset,
                      const dfloat solubilityRatio,
                      const dfloat diffRatio,
                      const dfloat Pe,
                      @ restrict const dfloat *C,
                      @ restrict const dfloat *PSI,
                      @ restrict const dfloat *DELTA,
                      @ restrict dfloat *F)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat p = fmin(1.0, fmax(0.0, PSI[n]));
    const dfloat K = (1.0 - solubilityRatio) * scstDiffusivity(p, solubilityRatio, diffRatio, Pe) /
                     (solubilityRatio * p + 1.0 - p);

    const dfloat gradphix = F[n + 0*offset];
    const dfloat gradphiy = F[n + 1*offset];
    const dfloat gradphiz = F[n + 2*offset];
    const dfloat mag = sqrt(gradphix*gradphix + gradphiy*gradphiy + gradphiz*gradphiz);
    const dfloat coeff = (mag > 1e-12) ? K * C[n] * DELTA[n] / mag : 0.0;

    F[n + 0*offset] = coeff * gradphix;
    F[n + 1*offset] = coeff * gradphiy;
    F[n + 2*offset] = coeff * gradphiz;
  }
}

@kernel void clearBoundaryBelowFreeSurface(const dlong Nelements,
                                           const dlong bID,
                                           const dfloat freeSurfaceZ,
                                           const dfloat clearThreshold,
                                           const dfloat epsilon,
                                           @ restrict const dlong *vmapM,
                                           @ restrict const int *EToBM,
                                           @ restrict const dfloat *Z,
                                           @ restrict dfloat *PSI)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    for (int t = 0; t < p_Nfp; ++t; @inner(0)) {
      for (int f = 0; f < p_Nfaces; ++f) {
        const dlong boundaryID = EToBM[f + p_Nfaces*e];
        if (boundaryID == bID) {
          const dlong sid = e*p_Nfaces*p_Nfp + f*p_Nfp + t;
          const dlong id = vmapM[sid];
          if (Z[id] < clearThreshold) {
            const dfloat phi = freeSurfaceZ - Z[id];
            const dfloat theta = phi / (2.0 * epsilon);
            PSI[id] = 0.5 * (tanh(theta) + 1.0);
          }
        }
      }
    }
    @barrier;
  }
}

@kernel void clearBoundaryAboveFreeSurface(const dlong Nelements,
                                           const dlong bID,
                                           const dfloat freeSurfaceZ,
                                           const dfloat clearThreshold,
                                           const dfloat epsilon,
                                           @ restrict const dlong *vmapM,
                                           @ restrict const int *EToBM,
                                           @ restrict const dfloat *Z,
                                           @ restrict dfloat *PSI)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    for (int t = 0; t < p_Nfp; ++t; @inner(0)) {
      for (int f = 0; f < p_Nfaces; ++f) {
        const dlong boundaryID = EToBM[f + p_Nfaces*e];
        if (boundaryID == bID) {
          const dlong sid = e*p_Nfaces*p_Nfp + f*p_Nfp + t;
          const dlong id = vmapM[sid];
          if (Z[id] > clearThreshold) {
            const dfloat phi = freeSurfaceZ - Z[id];
            const dfloat theta = phi / (2.0 * epsilon);
            PSI[id] = 0.5 * (tanh(theta) + 1.0);
          }
        }
      }
    }
    @barrier;
  }
}

@kernel void clearAboveFreeSurface(const dlong N,
                                   const dfloat clearThreshold,
                                   @ restrict const dfloat *Z,
                                   @ restrict dfloat *PSI)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat z = Z[n];
    const dfloat psi = PSI[n];

    if(z > clearThreshold) {
      PSI[n] = fmin(0.01, psi);
    }
  }
}

@kernel void clearVolumeBelowInjector(const dlong N,
                                      const dfloat injectorZ,
                                      const dfloat radialThreshold,
                                      const dfloat bottomClearZ,
                                      @ restrict const dfloat *X,
                                      @ restrict const dfloat *Y,
                                      @ restrict const dfloat *Z,
                                      @ restrict dfloat *PSI)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat radialThresholdSq = radialThreshold * radialThreshold;
    const dfloat radiusSq = X[n]*X[n] + Y[n]*Y[n];

    const bool inLowerPeripheralRegion =
        (Z[n] < injectorZ) && (radiusSq > radialThresholdSq);
    const bool withinBottomClearance = Z[n] < bottomClearZ;

    if (inLowerPeripheralRegion || withinBottomClearance) {
      PSI[n] = fmax(1.0 - 0.01, PSI[n]);
    }
  }
}

@kernel void applyOutletViscositySponge(const dlong N,
                                        const dfloat spongeStartZ,
                                        const dfloat spongeEndZ,
                                        const dfloat maxMultiplier,
                                        @ restrict const dfloat *Z,
                                        @ restrict dfloat *viscosity)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    // C1-continuous smoothstep: no viscosity-gradient jump at either end.
    dfloat eta = (Z[n] - spongeStartZ) / (spongeEndZ - spongeStartZ);
    eta = max(0.0, min(1.0, eta));
    const dfloat ramp = eta * eta * (3.0 - 2.0 * eta);
    const dfloat multiplier = 1.0 + (maxMultiplier - 1.0) * ramp;
    viscosity[n] *= multiplier;
  }
}

@kernel void computeNodalCFL(const dlong Nelements,
                             const dfloat dt,
                             const dlong velocityOffset,
                             @ restrict const dfloat *vgeo,
                             @ restrict const dfloat *gllz,
                             @ restrict const dfloat *U,
                             @ restrict dfloat *nodalCFL)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    for (int k = 0; k < p_Nq; ++k) {
      for (int j = 0; j < p_Nq; ++j; @inner(1)) {
        for (int i = 0; i < p_Nq; ++i; @inner(0)) {
          const dlong id = e*p_Np + k*p_Nq*p_Nq + j*p_Nq + i;
          const dlong gid = e*p_Np*p_Nvgeo + k*p_Nq*p_Nq + j*p_Nq + i;

          const dfloat dr = (i == 0) ? gllz[1] - gllz[0] : ((i == p_Nq - 1) ? gllz[p_Nq - 1] - gllz[p_Nq - 2] : 0.5*(gllz[i + 1] - gllz[i - 1]));
          const dfloat ds = (j == 0) ? gllz[1] - gllz[0] : ((j == p_Nq - 1) ? gllz[p_Nq - 1] - gllz[p_Nq - 2] : 0.5*(gllz[j + 1] - gllz[j - 1]));
          const dfloat dtRef = (k == 0) ? gllz[1] - gllz[0] : ((k == p_Nq - 1) ? gllz[p_Nq - 1] - gllz[p_Nq - 2] : 0.5*(gllz[k + 1] - gllz[k - 1]));

          const dfloat drdx = vgeo[gid + p_RXID*p_Np];
          const dfloat drdy = vgeo[gid + p_RYID*p_Np];
          const dfloat drdz = vgeo[gid + p_RZID*p_Np];
          const dfloat dsdx = vgeo[gid + p_SXID*p_Np];
          const dfloat dsdy = vgeo[gid + p_SYID*p_Np];
          const dfloat dsdz = vgeo[gid + p_SZID*p_Np];
          const dfloat dtdx = vgeo[gid + p_TXID*p_Np];
          const dfloat dtdy = vgeo[gid + p_TYID*p_Np];
          const dfloat dtdz = vgeo[gid + p_TZID*p_Np];

          const dfloat u = U[id + 0*velocityOffset];
          const dfloat v = U[id + 1*velocityOffset];
          const dfloat w = U[id + 2*velocityOffset];

          const dfloat cflR = fabs(u*drdx + v*drdy + w*drdz)*dt/dr;
          const dfloat cflS = fabs(u*dsdx + v*dsdy + w*dsdz)*dt/ds;
          const dfloat cflT = fabs(u*dtdx + v*dtdy + w*dtdz)*dt/dtRef;
          nodalCFL[id] = cflR + cflS + cflT;
        }
      }
    }
  }
}

@kernel void tlsic(const dlong N,
                   @ restrict const dfloat *X,
                   @ restrict const dfloat *Y,
                   @ restrict const dfloat *Z,
                   @ restrict dfloat *S)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat x = X[n];
    const dfloat y = Y[n];
    const dfloat z = Z[n];

    // S[n] < 0 for gas, = 0 at the interface, > 0 for liquid.
    // The generated mesh uses the tube diameter as reference length.
    const dfloat zFree = -46.9564724409449;

    // Geometry used by generate_discharge_section.py.
    const dfloat tubeX1 = -1.0;
    const dfloat tubeX2 =  1.0;
    const dfloat tubeY = 0.0;
    const dfloat tubeRadius = 0.5;
    const dfloat zDischarge = -52.4367874015748;
    const dfloat innerRadius = 2.0;
    const dfloat outerRadius = 6.43228560629921;
    const dfloat geometryTolerance = 5.0e-4;

    const dfloat dx1 = x - tubeX1;
    const dfloat dx2 = x - tubeX2;
    const dfloat dy = y - tubeY;
    const dfloat rTube1Sq = dx1*dx1 + dy*dy;
    const dfloat rTube2Sq = dx2*dx2 + dy*dy;
    const dfloat rTube1 = sqrt(rTube1Sq);
    const dfloat rTube2 = sqrt(rTube2Sq);
    const dfloat rShell = sqrt(x*x + dy*dy);

    // Boundary nodes projected onto an exact cylinder can fall infinitesimally
    // to either side of its nominal radius because of floating-point roundoff.
    // Use a small tolerance for region classification only; the distances
    // themselves continue to use the exact geometric radii.
    const bool insideTube1 =
        rTube1 <= tubeRadius + geometryTolerance;
    const bool insideTube2 =
        rTube2 <= tubeRadius + geometryTolerance;

    // In either tube bore above its discharge, the closest interface is the
    // flat circular discharge surface directly below the point.
    if ((z >= zDischarge) && (insideTube1 || insideTube2)) {
      S[n] = zDischarge - z;
    } else {
      // Exact unsigned distance to each finite circular discharge surface.
      // Inside a disk's projected radius this reduces to vertical distance;
      // outside it includes the radial distance to the circular rim.
      const dfloat dzDischarge = z - zDischarge;
      const dfloat drTube1 = fmax(rTube1 - tubeRadius, 0.0);
      const dfloat drTube2 = fmax(rTube2 - tubeRadius, 0.0);
      const dfloat dDisk1 =
          sqrt(dzDischarge*dzDischarge + drTube1*drTube1);
      const dfloat dDisk2 =
          sqrt(dzDischarge*dzDischarge + drTube2*drTube2);

      // Exact unsigned distance to the finite annular free surface. In the
      // outer annulus this is vertical distance; inside or outside the annulus
      // it includes distance to the nearest annular rim.
      const dfloat dzFree = z - zFree;
      const dfloat drFreeInner = fmax(innerRadius - rShell, 0.0);
      const dfloat drFreeOuter = fmax(rShell - outerRadius, 0.0);
      const dfloat drFree = drFreeInner + drFreeOuter;
      const dfloat dFree = sqrt(dzFree*dzFree + drFree*drFree);

      // The connected outer/lower vessel takes distance to its nearest
      // gas/liquid interface. A minimum of continuous distance functions is
      // continuous, including across z = zDischarge.
      dfloat distance = fmin(dFree, fmin(dDisk1, dDisk2));

      // Only the outer annulus above the free surface is gas in this section.
      const bool inOuterAnnulus =
          (rShell >= innerRadius - geometryTolerance) &&
          (rShell <= outerRadius + geometryTolerance);
      if (inOuterAnnulus && (z > zFree)) {
        distance = -distance;
      }
      S[n] = distance;
    }
  }
}
