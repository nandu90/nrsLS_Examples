#include "lvlSet.hpp"

#ifdef __okl__

#include "ss1.oudf"
#include "projectSurface.oudf"

#endif

#include "projectSurface.inc"

static dfloat Re, We, Fr, Sc, Pe,Prd;
static dfloat rhoRatio, muRatio;
static dfloat solubilityRatio, diffRatio;
static dfloat lenScale;
static dfloat velScale;
static dfloat rhol;

// Nondimensional sparger geometry (tube diameter is the length scale).
static dfloat shellCenterX = 0.0;
static dfloat shellCenterY = 0.0;
static dfloat outerShellRadius = 6.43228560629921;
static dfloat innerShellRadius = 2.0;
static dfloat tubeRadius = 0.5;
static dfloat tube1CenterX = -1.0;
static dfloat tube2CenterX = 1.0;
static dfloat tubeCenterY = 0.0;
static dfloat injectorDischargeZ = -52.4367874015748;
static dfloat freeSurfaceZ = -46.9564724409449;
static dfloat outletZ = -36.9564724409449;
static dfloat surfaceProjectionTolerance = 0.025;
// Fraction across the annular gap measured from the inner shell toward the
// outer shell. Nodes at larger radii are cleared by clearVolumeBelowInjector.
static dfloat peripheralRadiusFraction = 0.85;
static dfloat vesselBottomZ = -58.736;

void preFluid(double time, int tstep)
{
  auto mesh = nrs->meshV;

  auto o_sforce = platform->deviceMemoryPool.reserve<dfloat>(nrs->fluid->fieldOffsetSum);
  platform->linAlg->fill(nrs->fluid->fieldOffsetSum, 0.0, o_sforce);

  lvlSet::applySurfaceTensionAcc(We, o_sforce);

  platform->linAlg->add(mesh->Nlocal, 
                        -1.0 / Fr,
                        o_sforce,
                        2 * nrs->fluid->fieldOffset);

  platform->linAlg->axmyVector(mesh->Nlocal,
                               nrs->fluid->fieldOffset,
                               0,
                               1.0,
                               mesh->o_Jw,
                               o_sforce);

  platform->linAlg->axpbyMany(mesh->Nlocal,
                              mesh->dim,
                              nrs->fluid->fieldOffset,
                              1.0,
                              o_sforce,
                              1.0,
                              nrs->fluid->o_JwF);
}

void uservp(double time)
{
  lvlSet::updateProperties(rhoRatio, muRatio, Re);

  auto mesh = nrs->meshV;
  speciesDiffusivity(mesh->Nlocal,
                     solubilityRatio,
                     diffRatio,
                     Pe,
                     nrs->scalar->o_solution("cls"),
                     nrs->scalar->o_diffusionCoeff("c"));
}

void userSource(double time)
{
  auto mesh = nrs->meshV;
  const auto offset = nrs->fluid->fieldOffset;

  auto o_flux = platform->deviceMemoryPool.reserve<dfloat>(3 * offset);
  opSEM::strongGrad(mesh, offset, nrs->scalar->o_solution("tls"), o_flux);
  scstFlux(mesh->Nlocal,
           offset,
           solubilityRatio,
           diffRatio,
           Pe,
           nrs->scalar->o_solution("c"),
           nrs->scalar->o_solution("cls"),
           lvlSet::getDeltaFunction(),
           o_flux);
  occa::memory o_source = nrs->scalar->o_explicitTerms("c");
  opSEM::divergence(mesh, offset, o_flux, o_source);
  oogs::startFinish(o_source, 1, 0, ogsDfloat, ogsAdd, mesh->oogs);
  platform->linAlg->axmy(mesh->Nlocal, -1.0, mesh->o_invAJw, o_source);
}

void reportSpecies(double time)
{
  auto mesh = nrs->meshV;
  auto o_c = nrs->scalar->o_solution("c");

  auto o_cpsi = platform->deviceMemoryPool.reserve<dfloat>(mesh->Nlocal);
  platform->linAlg->axmyz(mesh->Nlocal, 1.0, o_c, nrs->scalar->o_solution("cls"), o_cpsi);
  const auto cTotal = platform->linAlg->innerProd(mesh->Nlocal, mesh->o_LMM, o_c, platform->comm.mpiComm());
  const auto cLiquid = platform->linAlg->innerProd(mesh->Nlocal, mesh->o_LMM, o_cpsi, platform->comm.mpiComm());
  const auto cMin = platform->linAlg->min(mesh->Nlocal, o_c, platform->comm.mpiComm());
  const auto cMax = platform->linAlg->max(mesh->Nlocal, o_c, platform->comm.mpiComm());
  if (platform->comm.mpiRank() == 0) {
    // C_liquid and C_gas in [mol], c_min and c_max in [mol/m^3].
    printf("species: time=%.8e C_liquid=%.8e C_gas=%.8e c_min=%.8e c_max=%.8e\n",
           time, cLiquid, cTotal - cLiquid, cMin, cMax);
  }
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  options.setArgs("FLUID PRESSURE RHO SPLITTING", "TRUE");
  options.setArgs("FLUID PRESSURE RHO SPLITTING FILTER", "TRUE");
  options.setArgs("FLUID PRESSURE RHO SPLITTING UNSPLIT STEPS", "30");
  options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD", "TRUE");
}

void UDF_Setup()
{
  nrs->userProperties = &uservp;
  nrs->userSource = &userSource;
  nrs->preFluid = &preFluid;

  auto mesh = nrs->meshV;

  lenScale = 0.0015875;
  velScale = 0.21;

  // The generated mesh is already nondimensional and centered at (0,0).
  projectSurfaceToCylinder(2,
                           0.0, 0.0, 1.0,
                           shellCenterX, shellCenterY, 0.0,
                           outerShellRadius,
                           surfaceProjectionTolerance,
                           false); //outer shell
                                                 
  projectSurfaceToCylinder(5,
                           0.0, 0.0, 1.0,
                           shellCenterX, shellCenterY, 0.0,
                           innerShellRadius,
                           surfaceProjectionTolerance,
                           false); //inner shell

  projectSurfaceToCylinder(7,
                           0.0, 0.0, 1.0,
                           tube1CenterX, tubeCenterY, 0.0,
                           tubeRadius,
                           surfaceProjectionTolerance,
                           false); //tube 1
                                                   
  projectSurfaceToCylinder(7,
                           0.0, 0.0, 1.0,
                           tube2CenterX, tubeCenterY, 0.0,
                           tubeRadius,
                           surfaceProjectionTolerance,
                           false); //tube 2

  // All coordinate changes are complete; update geometric factors once.
  mesh->update();
                                                         
  lvlSet::setup();

  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    auto o_tls = nrs->scalar->o_solution("tls");
    auto o_cls = nrs->scalar->o_solution("cls");

    tlsic(mesh->Nlocal, mesh->o_x, mesh->o_y,mesh->o_z, o_tls);
    lvlSet::initHeaviside(o_tls, o_cls);
    platform->linAlg->fill(mesh->Nlocal, 0.0, nrs->scalar->o_solution("c"));
  }

  //Dimensionless params
  const dfloat gdim = 9.81;
  const dfloat rhol = 1627.0;
  const dfloat rhog = 0.622;
  const dfloat mul = 2.2e-3;
  const dfloat mug = 4.64e-5;
  const dfloat diffl = 1e-6; // placeholder, results in Sc = 1.35
  const dfloat diffg = 1e-3; // placeholder
  const dfloat sigma = 0.1;

  rhoRatio = rhol/rhog * 0.75;  //must be heavier / lighter
  muRatio =  mul/mug;  //must be heavier / lighter
  diffRatio = diffl/diffg; //must be heavier / lighter
  solubilityRatio = 1.0/3.0; // placeholder

  Re = rhol * velScale * lenScale / mul;
  Fr = velScale * velScale / (gdim * lenScale);
  We = lenScale * rhol * velScale * velScale / sigma;
  Sc = mul / rhol / diffl;
  Pe = Re * Sc;

  const auto interfaceWidth = lvlSet::getInterfaceWidth();
  platform->app->bc->o_usrwrk.resize(1);
  platform->app->bc->o_usrwrk.copyFrom(&interfaceWidth, 1);
}

void UDF_ExecuteStep(double time, int tstep)
{
  if(tstep == 1 && platform->comm.mpiRank() == 0) {
    printf("Reynolds Number: %.8e\n", Re);
    printf("Weber Number: %.8e\n", We);
    printf("Froude Number: %.8e\n", Fr);
    printf("Schmidt Number: %.8e\n", Sc);
    printf("Peclet Number: %.8e\n", Pe);
    printf("Density Ratio: %.8e\n", rhoRatio);
    printf("Viscosity Ratio: %.8e\n", muRatio);
    printf("Diffusivity Ratio: %.8e\n", diffRatio);
    printf("Solubility Ratio: %.8e\n", solubilityRatio);
  }
  lvlSet::solve(time);

  //prevent spurious interface above free surface
  auto mesh = nrs->meshV;
  auto o_cls = nrs->scalar->o_solution("cls");
  clearAboveFreeSurface(mesh->Nlocal, 
                        freeSurfaceZ + 4.0,
                        mesh->o_z,
                        o_cls);

  // Boundary ID 2 uses a zero-Neumann CLS condition. Restore the initial
  // signed-distance Heaviside profile sufficiently below the free surface,
  // leaving the evolving diffuse-interface band untouched.
  clearBoundaryBelowFreeSurface(mesh->Nelements,
                                2,
                                freeSurfaceZ,
                                freeSurfaceZ - 1.0,
                                lvlSet::getInterfaceWidth(),
                                mesh->o_vmapM,
                                mesh->o_EToB,
                                mesh->o_z,
                                o_cls);

  clearBoundaryAboveFreeSurface(mesh->Nelements,
                                2,
                                freeSurfaceZ,
                                freeSurfaceZ + 1.0,
                                lvlSet::getInterfaceWidth(),
                                mesh->o_vmapM,
                                mesh->o_EToB,
                                mesh->o_z,
                                o_cls);

  // Remove spurious gas/interface structures in the lower peripheral vessel.
  // Interpolate across the annular gap; multiplying the sum of the radii is
  // only correct for the special midpoint value 0.5.
  const dfloat peripheralRadius = innerShellRadius + peripheralRadiusFraction * (outerShellRadius - innerShellRadius);
  clearVolumeBelowInjector(mesh->Nlocal,
                           freeSurfaceZ - 2.0, //clear below this z-threshold
                           peripheralRadius,
                           vesselBottomZ + 2.0,
                           mesh->o_x,
                           mesh->o_y,
                           mesh->o_z,
                           o_cls);

  // Report species inventory to log.
  if (nrs->checkpointStep) {
    reportSpecies(time);
  }

#if 1
  const dfloat maxCFL = 2.0;
  const dfloat cfl = nrs->computeCFL(nrs->fluid->mesh, nrs->fluid->o_U, nrs->dt[0]);

  if (cfl > maxCFL || nrs->dt[0] < 1e-8) {
    auto fluidMesh = nrs->fluid->mesh;
    auto outputMesh = nrs->meshT;
    deviceMemory<dfloat> o_cflField(outputMesh->Nlocal);
    platform->linAlg->fill(outputMesh->Nlocal, 0.0, o_cflField);

    computeNodalCFL(fluidMesh->Nelements,
                    nrs->dt[0],
                    nrs->fluid->fieldOffset,
                    fluidMesh->o_vgeo,
                    fluidMesh->o_gllz,
                    nrs->fluid->o_U,
                    o_cflField);

    std::vector<deviceMemory<dfloat>> cflFields;
    cflFields.emplace_back(o_cflField);
    std::vector<std::tuple<std::string, std::vector<deviceMemory<dfloat>>>> cflOutput;
    cflOutput.emplace_back("scalar00", std::move(cflFields));
    if (platform->comm.mpiRank() == 0) {
      printf("CFL limit triggered (max=%.8e, dt=%.8e); writing nodal CFL field\n", cfl, nrs->dt[0]);
    }
    nrs->writeToFile("cfl",
                     time,
                     outputMesh,
                     cflOutput,
                     true,  // include coordinates for direct visualization
                     true); // write diagnostic field in FP64

    nrs->writeCheckpoint(time);

    nekrsCheck(true, 
               MPI_COMM_SELF,
               EXIT_FAILURE,
               "%s\n",
               "CFL > 1.0 || dt < 1e-8!");
  }
#endif
}
