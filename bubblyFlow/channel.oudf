@kernel void tlsic(const dlong N,
                   const dlong nBubbles,
                   const dfloat rBubble,
                   @ restrict const dfloat *coord,
                   @ restrict const dfloat *X,
                   @ restrict const dfloat *Y,
                   @ restrict const dfloat *Z,
                   @ restrict dfloat *S)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat x = X[n];
    const dfloat y = Y[n];
    const dfloat z = Z[n];

    dfloat phi = 1e20;

    for (dlong b = 0; b < nBubbles; ++b) {
      const dfloat xc = coord[b * 3 + 0];
      const dfloat yc = coord[b * 3 + 1];
      const dfloat zc = coord[b * 3 + 2];

      const dfloat dx = x - xc;
      const dfloat dy = y - yc;
      const dfloat dz = z - zc;

      const dfloat dist = sqrt(dx * dx + dy * dy + dz * dz);
      const dfloat phib = dist - rBubble;

      phi = fmin(phi, phib);
    }

    S[n] = phi;
  }
}

@kernel void nearWallStretching(const dlong N,
                                const dfloat betam,
                                @ restrict dfloat *Y)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat y = Y[n];
    Y[n] = tanh(betam * y) / tanh(betam);
  }
}

@kernel void updateThermalProperties(const dlong N,
                                     const dfloat conductivityLiquid,
                                     const dfloat conductivityGas,
                                     const dfloat rhoCpLiquid,
                                     const dfloat rhoCpGas,
                                     @ restrict const dfloat *CLS,
                                     @ restrict dfloat *CONDUCTIVITY,
                                     @ restrict dfloat *RHOCP)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat liquid = fmax(0.0, fmin(1.0, CLS[n]));
    CONDUCTIVITY[n] = liquid*conductivityLiquid
                    + (1.0 - liquid)*conductivityGas;
    RHOCP[n] = liquid*rhoCpLiquid + (1.0 - liquid)*rhoCpGas;
  }
}

@kernel void periodicHeatSource(const dlong N,
                                const dlong offset,
                                const dfloat meanTemperatureGradient,
                                @ restrict const dfloat *U,
                                @ restrict const dfloat *RHOCP,
                                @ restrict dfloat *SOURCE)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    SOURCE[n] = -RHOCP[n]*meanTemperatureGradient*U[n + 0*offset];
  }
}

void udfDirichlet(bcData *bc)
{
  if(isField("scalar cls") || isField("clsr")) {
    bc->sScalar = 1.0;
  }
}

void udfNeumann(bcData *bc)
{
  if(isField("scalar temperature")) {
    // Inward unit heat flux at both channel walls. NekRS expects the
    // conductive flux here (k*dT/dn), not an unscaled temperature gradient.
    bc->fluxScalar = 1.0;
  }
}
